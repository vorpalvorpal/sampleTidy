<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The auto-import trigger (dev/auto-import.sh), run by launchd so imports do not depend on any
  desktop application being open.
  WatchPaths fires when a new delivery folder appears in the input directory. A folder is only
  imported once it has settled (the deployment's settle time), and a delivery often arrives
  over several minutes, so StartInterval re-checks every 10 minutes until it settles. Each tick
  is cheap: auto-import.sh hashes stat() metadata and exits when nothing changed, and R holds a
  lock, so overlapping triggers cannot run two imports at once.
  The job runs a small launcher app (dev/launchd/helper) rather than /bin/bash: under launchd
  macOS refuses /bin/bash access to some protected folders (e.g. a File Provider / cloud-synced
  folder), and granting that to bash would grant it to every bash script. The launcher spawns
  dev/auto-import.sh as a child, so only the launcher app needs Full Disk Access.
  A template: dev/launchd/install.sh fills in @HELPER@, @REPO@, @INPUT@, @HOME@ and @LOCALE@
  and installs it to ~/Library/LaunchAgents. Do not load this file directly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.robinshannon.sampletidy-autoimport</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HELPER@</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>@INPUT@</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- Imports are not time-critical (2026-10-25): run as a background job so they never
       compete with foreground work. Background lets macOS throttle CPU and disk I/O and defer
       the job under load; Nice and LowPriorityIO cover the CPU and disk explicitly. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>15</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>LowPriorityBackgroundIO</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- launchd starts jobs in the C locale, where R cannot read the package's UTF-8
         source (units such as °C and µg/L): "unable to translate ... to native encoding". -->
    <key>LANG</key>
    <string>@LOCALE@</string>
    <key>LC_ALL</key>
    <string>@LOCALE@</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/sampletidy-autoimport-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/sampletidy-autoimport-launchd.log</string>
</dict>
</plist>
