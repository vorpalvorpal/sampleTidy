.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
*.duckdb
*.duckdb.wal
*.duckdb.lock
_problems
testthat-problems.rds

# tdd-plan build scratch. `dev/tdd-run/*` rather than `dev/tdd-run/` because git
# cannot re-include a file whose parent DIRECTORY is excluded - with the trailing
# slash the negation below is silently dead.
dev/tdd-run/*
# ...except the criterion bijection lint, which is a project tool that happens to
# live here, not run scratch. Phase 9's sign-off gate calls it, so a checkout
# without it cannot reproduce the coverage result.
!dev/tdd-run/criterion-lint.py

# PLAN-19 R-19.12: the QC code -> point table is confidential, never in git.
qc-codes*.csv
**/qc-codes*.csv
dev/migrations/049-*-BACKUP-*.csv
!tests/testthat/fixtures/qc/qc-codes-FAKE.csv

# Lab documents backed up during the 2026-07-23 asset swap: real data, never commit
dev/asset-swap-backup-2026-07-23/

# Migration run-time outputs (row dumps from the live DB): kept on disk, never committed
dev/migrations/*-BACKUP*.csv
dev/migrations/*-INSERTED*.csv
dev/migrations/*-SKIPPED*.csv

# EPA licences and EPA monitoring-data workbooks: real documents, never committed
dev/*.pdf
dev/epa_monitoring_data_K_*.xlsx
dev/~$*

# Operational state notes: deployment-specific, kept on disk only
dev/STATE.md
